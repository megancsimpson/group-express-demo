<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <title>My App</title>

  <link rel="stylesheet" href="/style.css">

</head>

<body>

  <% if (user) { %>

    <p>Welcome, <%= user.displayName %>!</p>

    <% if (user.email) { %>
      <p><%= user.email %></p>
    <% } %>

    <% if (user.photo) { %>
      <img src="<%= user.photo %>" alt="avatar" width="64">
    <% } %>

    <br><br>

    <a href="/logout">Sign out</a>

  <% } else { %>

    <h1>My App</h1>

    <p>Sign in to continue.</p>

    <a href="/auth/google">Sign in with Google</a>

  <% } %>

</body>

</html>
