<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About This App</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f0f4f8;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .card {
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      padding: 40px 50px;
      max-width: 500px;
      width: 100%;
      text-align: center;
    }

    .badge {
      display: inline-block;
      background-color: #4f46e5;
      color: white;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 20px;
      margin-bottom: 16px;
    }

    h1 {
      font-size: 28px;
      color: #1e293b;
      margin-bottom: 8px;
    }

    .description {
      color: #64748b;
      font-size: 15px;
      margin-bottom: 30px;
      line-height: 1.6;
    }

    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      text-align: left;
    }

    .info-item {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 16px;
    }

    .info-item .label {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #94a3b8;
      margin-bottom: 4px;
    }

    .info-item .value {
      font-size: 16px;
      font-weight: 600;
      color: #1e293b;
    }

    .footer {
      margin-top: 30px;
      font-size: 13px;
      color: #94a3b8;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1><%= name %></h1>
    <p class="description"><%= description %></p>

    <div class="info-grid">
      <div class="info-item">
        <div class="label">App Name</div>
        <div class="value"><%= name %></div>
      </div>
      <div class="info-item">
        <div class="label">Running on Port</div>
        <div class="value"><%= port %></div>
      </div>
    </div>

      </div>
</body>
</html>
